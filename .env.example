# =============================================================================
# Life Hub — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values. .env.local is gitignored;
# .env.example is committed. Never put real secrets in .env.example.
#
# Two ways to populate these:
#
#   A) Hosted Supabase project (recommended — no Docker needed):
#      1. Open https://supabase.com/dashboard → your project.
#      2. Project Settings → API:
#         - "Project URL"        → NEXT_PUBLIC_SUPABASE_URL
#         - "anon public" key    → NEXT_PUBLIC_SUPABASE_ANON_KEY
#         - "service_role" key   → SUPABASE_SERVICE_ROLE_KEY
#      3. Project Settings → Database → Connection string → URI:
#         - copy that into DATABASE_URL (only needed if running raw SQL outside Supabase)
#
#   B) Local Supabase stack (optional — requires Docker Desktop):
#      1. Install Supabase CLI + Docker Desktop (see README "Optional: local Supabase").
#      2. Run `supabase start` from the repo root.
#      3. The CLI prints an `API URL`, `anon key`, and `service_role key`.
#         Paste them below.
#
# After editing, fully restart `pnpm dev` — Next.js only reads env vars at startup.
# =============================================================================


# -----------------------------------------------------------------------------
# PUBLIC — bundled into client JavaScript. Safe to expose to the browser.
# These point at the Supabase API and authenticate as the "anonymous" role,
# which is gated by Row Level Security policies in the database.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=


# -----------------------------------------------------------------------------
# SERVER-ONLY — never prefix these with NEXT_PUBLIC_, never import them in a
# client component. service_role bypasses Row Level Security entirely, so it
# must NEVER reach the browser.
# -----------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=


# -----------------------------------------------------------------------------
# OPTIONAL — site-wide passcode gate. When set, the whole site is locked behind
# an HTTP Basic prompt (any username + this value as the password) before any
# page or API loads. Leave blank for local dev. Set it in the hosting provider's
# env vars to lock the live site down to just you. Remove it to reopen the site.
# -----------------------------------------------------------------------------
SITE_PASSCODE=


# -----------------------------------------------------------------------------
# Encryption key for secrets stored in the database — assistant provider API
# keys (BYOK) AND third-party integration OAuth tokens (e.g. Strava). 64 hex
# chars = 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required before connecting any integration or storing a provider key.
# -----------------------------------------------------------------------------
AI_SETTINGS_MASTER_KEY=


# -----------------------------------------------------------------------------
# Strava integration (Phase 5). Server-only — never prefix with NEXT_PUBLIC_.
# Create an API application at https://www.strava.com/settings/api to get these.
# Set the app's "Authorization Callback Domain" to the host you test on
# (e.g. projectkosmos.com for prod, or localhost for a dev app — Strava allows
# one domain per app). Leave blank to hide/disable the Strava integration.
# -----------------------------------------------------------------------------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
